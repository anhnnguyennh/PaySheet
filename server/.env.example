# Leave any of these unset and PaySheet runs in mock mode automatically.

# Claude API key. Without it, row-parsing falls back to a deterministic
# heuristic parser (good enough to demo, not as smart as the real thing).
ANTHROPIC_API_KEY=

# PayPal sandbox app credentials (developer.paypal.com -> My Apps & Credentials
# -> Sandbox). Without these, payouts/invoices/webhooks are simulated locally.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=

PORT=4000
